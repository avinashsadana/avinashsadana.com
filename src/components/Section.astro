---
interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  id?: string;
  /** Adds a hairline rule above the section. */
  divider?: boolean;
  class?: string;
}

const { eyebrow, title, lead, id, divider = false, class: className } = Astro.props;
---

<section
  id={id}
  class:list={[
    'shell scroll-mt-24 py-10 lg:py-20',
    divider && 'section-rule border-t border-line',
    className,
  ]}
>
  {
    (eyebrow || title || lead) && (
      <header class="max-w-3xl">
        {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
        {title && (
          <h2
            class="reveal mt-4 font-display text-section font-bold text-ink"
            style="--reveal-delay: 60ms"
          >
            {title}
          </h2>
        )}
        {lead && (
          <p class="prose-body reveal mt-5" style="--reveal-delay: 100ms">
            {lead}
          </p>
        )}
      </header>
    )
  }

  <div class:list={[(eyebrow || title || lead) && 'mt-7 lg:mt-12']}>
    <slot />
  </div>
</section>

<style>
  /* The rule between sections carries a single point of light where the
     content column begins — a horizon with one star on it. Nothing more:
     the motif has to survive being repeated on every page. */
  .section-rule {
    position: relative;
  }

  .section-rule::before {
    content: '';
    position: absolute;
    top: -3px;
    left: 1.5rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--c-gold);
  }

  @media (min-width: 1024px) {
    .section-rule::before {
      left: 3rem;
    }
  }
</style>
