---
/**
 * The breadth, shown rather than claimed.
 *
 * This replaces the paragraphs that used to assert Avinash does many things.
 * Six tiles, one number each — a reader gets the whole picture in about two
 * seconds and can dig into any of it. Tiles are links, so this is navigation
 * as well as illustration.
 */

const facets = [
  {
    label: 'Operations',
    metric: '3',
    unit: 'sectors',
    note: 'Heavy engineering, food, power',
    href: '/work',
    icon: 'M4 19.5V7l7-3.5L18 7v12.5M4 19.5h14M8 19.5v-5h6v5',
  },
  {
    label: 'Ventures',
    metric: '2',
    unit: 'founded',
    note: 'Both still running',
    href: '/ventures',
    icon: 'M12 3.5 5 8v8l7 4.5 7-4.5V8l-7-4.5ZM12 12v8.5M12 12 5 8M12 12l7-4',
  },
  {
    label: 'Endurance',
    metric: '646',
    unit: 'km',
    note: '2nd, Pune to Goa',
    href: '/endurance',
    icon: 'M5.5 17.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM18.5 17.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM5.5 14.5l4-7h5l4 7M9.5 7.5h4',
  },
  {
    label: 'Reading',
    metric: '27',
    unit: 'on the shelf',
    note: 'Gita to Kahneman',
    href: '/reading',
    icon: 'M4 5.5h6a2 2 0 0 1 2 2v11a2 2 0 0 0-2-2H4v-11ZM20 5.5h-6a2 2 0 0 0-2 2v11a2 2 0 0 1 2-2h6v-11Z',
  },
  {
    label: 'Writing',
    metric: '5',
    unit: 'essays',
    note: 'Models, process, distance',
    href: '/writing',
    icon: 'M4 20h16M5 16.5l10.5-10.5a2.1 2.1 0 0 1 3 3L8 19.5l-4 .5.5-3.5Z',
  },
  {
    label: 'Recognition',
    metric: '8',
    unit: 'awards',
    note: 'NCC, NSS, photography, poetry',
    href: '/about',
    icon: 'M12 15.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11ZM8.5 14.5 7 21l5-2.5L17 21l-1.5-6.5',
  },
] as const;
---

<ul class="facets">
  {
    facets.map((f, i) => (
      <li class="reveal" style={`--reveal-delay:${i * 60}ms`}>
        <a href={f.href} class="facet">
          <svg
            class="facet-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={f.icon} />
          </svg>

          <p class="facet-metric">
            {f.metric}
            <span class="facet-unit">{f.unit}</span>
          </p>
          <p class="facet-label">{f.label}</p>
          <p class="facet-note">{f.note}</p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .facets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    list-style: none;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--c-border);
    border-radius: 16px;
    background-color: var(--c-border);
  }

  @media (min-width: 720px) {
    .facets {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .facet {
    display: block;
    height: 100%;
    padding: 1.5rem 1.35rem 1.6rem;
    background-color: var(--c-bg);
    transition: background-color 0.2s ease;
  }

  .facet:hover {
    background-color: var(--c-bg-raised);
  }

  .facet-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--c-gold);
  }

  .facet-metric {
    margin-top: 1.15rem;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--c-text);
    font-variant-numeric: tabular-nums;
  }

  .facet-unit {
    margin-left: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--c-text-subtle);
  }

  .facet-label {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--c-text);
  }

  .facet-note {
    margin-top: 0.15rem;
    font-size: 0.8rem;
    color: var(--c-text-muted);
  }
</style>
