---
interface Props {
  /** Numeric target — animates from 0 when it scrolls into view. */
  value: number;
  suffix?: string;
  label: string;
  detail?: string;
  delay?: number;
}

const { value, suffix = '', label, detail, delay = 0 } = Astro.props;
---

<div class="reveal" style={`--reveal-delay: ${delay}ms`}>
  <p class="font-display text-4xl leading-none font-bold tracking-tight text-ink tabular-nums lg:text-5xl">
    <span data-count-to={value} data-count-suffix={suffix}>0{suffix}</span>
  </p>
  <p class="mt-3 text-sm font-semibold text-ink">{label}</p>
  {detail && <p class="mt-1 text-sm text-muted">{detail}</p>}
</div>
