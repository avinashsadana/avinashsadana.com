---
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, isoDate } from '../../lib/content';
import { getPublishedPosts, readingTime } from '../../lib/posts';
import { site } from '../../site.config';

// Rendered on demand so a newly published article appears immediately, rather
// than waiting for a rebuild.
export const prerender = false;

const posts = await getPublishedPosts();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${site.url}/writing#blog`,
  name: 'Avinash Sadana — Writing',
  description: 'Essays on business models, process, operations and endurance sport.',
  url: `${site.url}/writing`,
  author: { '@id': `${site.url}/#person` },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    url: `${site.url}/writing/${post.slug}`,
    datePublished: post.pubDate.toISOString(),
  })),
};
---

<BaseLayout
  title="Writing"
  description="Essays by Avinash Sadana on business models, process, operations and endurance sport."
  schema={schema}
>
  <PageHeader
    eyebrow="Writing"
    title="Notes on operations, ventures and distance"
    lead="Occasional essays. Mostly about the unglamorous parts — the handoffs, the logistics, the planning that only looks obvious afterwards."
  />

  <Section>
    {
      posts.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-line bg-bg-raised p-10 text-center lg:p-16">
          <p class="font-display text-2xl font-bold tracking-tight text-ink">
            Nothing published yet.
          </p>
          <p class="prose-body mx-auto mt-3">
            Subscribe to the{' '}
            <a href="/rss.xml" class="link-underline font-medium text-ink">
              RSS feed
            </a>{' '}
            if you want the first one when it lands.
          </p>
        </div>
      ) : (
        <ul class="divide-y divide-line border-y border-line">
          {posts.map((post, index) => (
            <li class="reveal" style={`--reveal-delay: ${index * 70}ms`}>
              <a href={`/writing/${post.slug}`} class="group block py-8 lg:py-10">
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-medium text-subtle">
                  <time datetime={isoDate(post.pubDate)}>{formatDate(post.pubDate)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{readingTime(post.body)}</span>
                </div>

                <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-ink lg:text-3xl">
                  <span class="link-underline">{post.title}</span>
                </h2>
                <p class="prose-body mt-3">{post.description}</p>

                {post.tags.length > 0 && (
                  <ul class="mt-5 flex flex-wrap gap-2">
                    {post.tags.map((tag) => (
                      <li class="rounded-full border border-line px-3 py-1 text-xs font-medium text-muted">
                        {tag}
                      </li>
                    ))}
                  </ul>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </Section>
</BaseLayout>
