---
import FormField from '../components/FormField.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, socials } from '../site.config';
---

<BaseLayout
  title="Contact"
  description={`Get in touch with Avinash Sadana — ${site.email}. Open to conversations about supply chain, operations, programme management roles and cycling.`}
>
  <PageHeader
    eyebrow="Contact"
    title="Start a conversation"
    lead="Roles, collaborations, event partnerships, or just a question about a route. I read everything and reply to what I can."
  />

  <Section>
    <div class="grid gap-12 lg:grid-cols-[1.25fr_1fr] lg:gap-20">
      <form id="contact-form" class="reveal space-y-6" novalidate>
        <!-- Honeypot: positioned off-screen rather than display:none, because
             some bots skip hidden fields. Real people never see or tab to it. -->
        <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
          <label for="company">Company</label>
          <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <FormField
            name="name"
            label="Your name"
            required
            maxlength={120}
            autocomplete="name"
            placeholder="Priya Sharma"
          />
          <FormField
            name="email"
            label="Email"
            type="email"
            required
            maxlength={254}
            autocomplete="email"
            placeholder="you@company.com"
          />
        </div>

        <FormField
          name="subject"
          label="Subject"
          maxlength={180}
          placeholder="Supply chain role at…"
        />

        <FormField
          name="message"
          label="Message"
          type="textarea"
          required
          maxlength={5000}
          rows={7}
          placeholder="Tell me what you have in mind."
        />

        <div class="flex flex-wrap items-center gap-4">
          <button
            type="submit"
            class="btn-primary"
            data-submit
          >
            <span data-submit-label>Send message</span>
            <span class="contents" data-spinner hidden>
              <svg
                class="size-4 animate-spin"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 3.5a8.5 8.5 0 1 0 8.5 8.5"></path>
              </svg>
            </span>
          </button>

          <p class="text-xs text-subtle">Usually a reply within a couple of days.</p>
        </div>

        <div
          class="rounded-xl border px-5 py-4 text-sm font-medium"
          role="status"
          aria-live="polite"
          data-form-status
          hidden
        >
        </div>
      </form>

      <aside class="reveal space-y-10" style="--reveal-delay: 100ms">
        <div>
          <h2 class="eyebrow">Direct</h2>
          <a
            href={`mailto:${site.email}`}
            class="link-underline mt-4 inline-block font-display text-lg font-bold break-words text-ink"
          >
            {site.email}
          </a>
        </div>

        <div>
          <h2 class="eyebrow">Elsewhere</h2>
          <ul class="mt-4 space-y-2">
            {
              socials
                .filter((item) => item.href.startsWith('http'))
                .map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="link-underline text-sm text-muted hover:text-ink"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {item.handle}
                    </a>
                  </li>
                ))
            }
          </ul>
        </div>

        <div>
          <h2 class="eyebrow">Based in</h2>
          <p class="mt-4 text-sm text-muted">{site.location}<br />Open to relocation</p>
        </div>

        <div class="rounded-2xl border border-line bg-bg-raised p-6">
          <p class="prose-body text-[0.9rem]">
            Want to leave something public instead? There’s a{' '}
            <a href="/guestbook" class="link-underline font-medium text-ink">guestbook</a>.
          </p>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>

<script>
  interface ApiResponse {
    ok?: boolean;
    message?: string;
    error?: string;
    field?: string;
  }

  function bindContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    // Used to reject submissions that arrive impossibly fast.
    const renderedAt = Date.now();

    const button = form.querySelector<HTMLButtonElement>('[data-submit]');
    const label = form.querySelector<HTMLElement>('[data-submit-label]');
    const spinner = form.querySelector<HTMLElement>('[data-spinner]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');

    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>('[data-field-error]').forEach((el) => {
        el.textContent = '';
        el.hidden = true;
      });
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    };

    const showFieldError = (field: string, message: string) => {
      const input = form.querySelector<HTMLElement>(`[name="${field}"]`);
      const error = document.getElementById(`${field}-error`);
      input?.setAttribute('aria-invalid', 'true');
      if (error) {
        error.textContent = message;
        error.hidden = false;
      }
      (input as HTMLInputElement | null)?.focus();
    };

    const showStatus = (message: string, ok: boolean) => {
      if (!status) return;
      status.textContent = message;
      status.hidden = false;
      status.className = ok
        ? 'rounded-xl border border-accent/40 bg-accent-soft px-5 py-4 text-sm font-medium text-accent'
        : 'rounded-xl border border-line bg-bg-sunken px-5 py-4 text-sm font-medium text-ink';
    };

    const setBusy = (busy: boolean) => {
      if (button) button.disabled = busy;
      if (label) label.textContent = busy ? 'Sending…' : 'Send message';
      if (spinner) spinner.hidden = !busy;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();

      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') ?? ''),
        email: String(data.get('email') ?? ''),
        subject: String(data.get('subject') ?? ''),
        message: String(data.get('message') ?? ''),
        company: String(data.get('company') ?? ''),
        elapsedMs: Date.now() - renderedAt,
      };

      // Validate in the browser first so obvious mistakes never cost a round-trip.
      if (payload.name.trim().length < 2) {
        showFieldError('name', 'Please tell me your name.');
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(payload.email.trim())) {
        showFieldError('email', 'That email address doesn’t look right.');
        return;
      }
      if (payload.message.trim().length < 10) {
        showFieldError('message', 'Please write a slightly longer message.');
        return;
      }

      setBusy(true);

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = (await response.json().catch(() => ({}))) as ApiResponse;

        if (response.ok && result.ok) {
          form.reset();
          showStatus(result.message ?? 'Thanks — your message is on its way.', true);
          return;
        }

        if (result.field) {
          showFieldError(result.field, result.error ?? 'Please check this field.');
          return;
        }

        showStatus(
          result.error ?? 'Something went wrong. Please email me directly instead.',
          false,
        );
      } catch {
        // Network failure — the most likely cause is the visitor being offline.
        showStatus(
          'Couldn’t reach the server. Check your connection, or email me directly.',
          false,
        );
      } finally {
        setBusy(false);
      }
    });
  }

  bindContactForm();
  document.addEventListener('astro:page-load', bindContactForm);
</script>
