---
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dateRange, getVentures } from '../../lib/content';

const ventures = await getVentures();
---

<BaseLayout
  title="Ventures"
  description="The WeDesi Festival and Cycle N’ Chai — two things Avinash Sadana founded and still runs or mentors."
>
  <PageHeader
    eyebrow="Ventures"
    title="Two things I started"
    lead="A music festival in Gujarat and a pan-India cycling community. Both began as something to do on a weekend. Neither stayed that way."
  />

  <Section>
    <div class="space-y-8">
      {
        ventures.map((venture, index) => (
          <a
            href={`/ventures/${venture.id}`}
            class="reveal group block rounded-2xl border border-line bg-bg-raised p-8 transition-colors hover:border-line-strong lg:p-12"
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:gap-14">
              <div>
                <p class="text-xs font-semibold tracking-[0.14em] text-accent uppercase">
                  {venture.data.role} · {dateRange(venture.data.start, venture.data.end, venture.data.current)}
                </p>
                <h2 class="mt-4 font-display text-section font-bold tracking-tight text-ink">
                  <span class="link-underline">{venture.data.name}</span>
                </h2>
                <p class="mt-3 font-display text-lg font-semibold text-muted">
                  {venture.data.tagline}
                </p>
                <p class="prose-body mt-6">{venture.data.summary}</p>
              </div>

              {venture.data.stats.length > 0 && (
                <dl class="grid grid-cols-2 gap-6 self-start lg:grid-cols-1 lg:border-l lg:border-line lg:pl-10">
                  {venture.data.stats.map((stat) => (
                    <div>
                      <dt class="text-xs tracking-wide text-subtle uppercase">{stat.label}</dt>
                      <dd class="mt-1.5 font-display text-2xl font-bold tracking-tight text-ink">
                        {stat.value}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </Section>
</BaseLayout>
