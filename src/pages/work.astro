---
import ArrowLink from '../components/ArrowLink.astro';
import Method from '../components/Method.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { dateRange, getCapabilities, getCertifications, getExperience } from '../lib/content';

const experience = await getExperience();
const capabilities = await getCapabilities();
const certifications = await getCertifications();
---

<BaseLayout
  title="Work"
  description="Programme management, process design and strategy — across heavy engineering, food manufacturing and power. Capabilities, track record and method."
>
  <PageHeader
    eyebrow="Work"
    title="Programmes, processes, and the seams between them"
    lead="Three sectors, one habit: find where the work stalls and rebuild it so it doesn’t."
  />

  <!-- The record as a picture first. -->
  <Section eyebrow="Track record" title="Where and when">
    <Timeline />
  </Section>

  <!-- Method as a diagram, rather than a paragraph claiming how I think. -->
  <Section
    eyebrow="Method"
    title="How I approach a problem"
    lead="The same four moves, whether it’s a Procure-to-Pay cycle or getting four hundred people fed at a festival."
    divider
  >
    <Method />
  </Section>

  <!-- Roles, compressed: dates, scope, and what it involved. No essays. -->
  <Section eyebrow="Experience" title="Roles" id="experience" divider>
    <ol class="roles">
      {
        experience.map((entry) => (
          <li class="role reveal" id={entry.id}>
            <div class="role-when">
              <span class="role-dates">
                {dateRange(entry.data.start, entry.data.end, entry.data.current)}
              </span>
              {entry.data.current && <span class="role-live" aria-label="current role" />}
            </div>

            <div>
              <h3 class="role-org">
                {entry.data.orgUrl ? (
                  <a
                    href={entry.data.orgUrl}
                    class="link-underline"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {entry.data.org}
                  </a>
                ) : (
                  entry.data.org
                )}
              </h3>
              <p class="role-title">{entry.data.role}</p>
              <p class="role-summary">{entry.data.summary}</p>

              {entry.data.projects.length > 0 && (
                <ul class="role-tags">
                  {entry.data.projects.map((project) => (
                    <li>{project.title}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section eyebrow="Capabilities" title="What I bring" id="capabilities" divider>
    <div class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-2">
      {
        capabilities.map((group) => (
          <div class="bg-bg p-6 lg:p-7">
            <h3 class="font-display text-lg font-bold tracking-tight text-ink">
              {group.data.group}
            </h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.data.items.map((item) => (
                <li class="rounded-full border border-line px-3 py-1.5 text-xs font-medium text-muted">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <Section eyebrow="Certifications" title="Formal training" id="certifications" divider>
    <ul class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
      {
        certifications.map((cert) => (
          <li class="bg-bg p-5">
            <p class="text-sm font-semibold text-ink">{cert.data.name}</p>
            <p class="mt-1 text-xs text-muted">{cert.data.issuer}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-9 flex flex-wrap gap-x-8 gap-y-3">
      <ArrowLink href="/resume">Full résumé</ArrowLink>
      <ArrowLink href="/contact">Start a conversation</ArrowLink>
    </div>
  </Section>
</BaseLayout>

<style>
  .roles {
    list-style: none;
    padding: 0;
  }

  .role {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 1.6rem 0 1.6rem 1.6rem;
    border-left: 1px solid var(--c-border);
    scroll-margin-top: 6rem;
  }

  @media (min-width: 768px) {
    .role {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 0 2.5rem;
      padding-left: 2.25rem;
    }
  }

  /* Marker on the spine; the current role gets the signature gold. */
  .role::before {
    content: '';
    position: absolute;
    top: 2.05rem;
    left: -4.5px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--c-border-strong);
  }

  .role:first-child::before {
    background-color: var(--c-gold);
    box-shadow: 0 0 0 4px var(--c-accent-soft);
  }

  .role-when {
    display: flex;
    align-items: center;
    align-self: start;
    gap: 0.5rem;
    padding-top: 0.55rem;
  }

  .role-dates {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: var(--c-text-subtle);
    white-space: nowrap;
  }

  .role-live {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background-color: var(--c-gold);
  }

  .role-org {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--c-text);
  }

  .role-title {
    margin-top: 0.15rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--c-accent);
  }

  .role-summary {
    margin-top: 0.7rem;
    max-width: 62ch;
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--c-text-muted);
  }

  .role-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
    list-style: none;
    padding: 0;
  }

  .role-tags li {
    border: 1px solid var(--c-border);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    font-size: 0.72rem;
    color: var(--c-text-muted);
  }
</style>
