---
import { Image } from 'astro:assets';
import ArrowLink from '../components/ArrowLink.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAchievements, getCertifications, getEducation } from '../lib/content';
import { socials } from '../site.config';
import portrait from '../assets/avinash-sadana.jpg';

const education = await getEducation();
const certifications = await getCertifications();
const achievements = await getAchievements();

const categories = [
  { key: 'leadership', label: 'Leadership & service' },
  { key: 'academic', label: 'Academic & competitive' },
  { key: 'sport', label: 'Sport' },
  { key: 'creative', label: 'Creative' },
] as const;
---

<BaseLayout
  title="About"
  description="Avinash Sadana — MBA candidate in International Business, Lean Six Sigma Green Belt, founder of The WeDesi Festival and Cycle N’ Chai, and an ultra-distance cyclist based in Pune, India."
>
  <PageHeader
    eyebrow="About"
    title="The short version, and the longer one"
    lead="Engineer by training, operations by instinct, and a cyclist for long enough that it has changed how I plan everything else."
  />

  <Section>
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-20">
      <div class="prose-body reveal space-y-5 text-[1.0625rem]">
        <p>
          I started in Instrumentation & Control Engineering, which taught me to look at
          a system and ask what is actually being measured. I finished that degree with
          distinction and went straight into an MBA in International Business at MIT World
          Peace University, because the questions I found interesting had stopped being
          technical ones.
        </p>
        <p>
          Since then the work has been operational. At Godrej & Boyce I worked inside the
          process equipment business — procurement, strategic sourcing and supplier
          development for the steel and specialised internals that go into industrial
          process equipment. Two projects came out of it: an optimisation of the
          Procure-to-Pay cycle, and a global market study across oil & gas, power, energy
          and hydrogen that fed into international expansion strategy.
        </p>
        <p>
          Before that I spent a season on a manufacturing floor at TopNotch Foods, running
          quality control and production planning for ice cream cone manufacturing. It is
          the least glamorous line on my résumé and probably the most useful — there is no
          substitute for standing next to a line that is running.
        </p>
        <p>
          Outside employment, I have built two things that are still running. The WeDesi
          Festival started in Gujarat in November 2020, in the middle of restrictions on
          public gatherings, and reached five editions and 700+ attendees before I stepped
          back into a mentoring role. Cycle N’ Chai has been going since 2018 as a
          pan-India community for cyclists — rides, races and bikepacking events.
        </p>
        <p>
          And I ride. Second place over 646 kilometres from Pune to Goa at the Deccan
          Cliffhanger, plus a stack of 300 to 1000 kilometre rides and triathlon. It is
          not a separate hobby from the professional work; it is where I learned that
          plans have to be built for the tired version of you.
        </p>
      </div>

      <aside class="reveal space-y-10" style="--reveal-delay: 100ms">
        <Image
          src={portrait}
          alt="Avinash Sadana"
          width={760}
          densities={[1, 2]}
          quality={78}
          class="aspect-square w-full max-w-sm rounded-2xl object-cover"
        />

        <div>
          <h2 class="eyebrow">Based in</h2>
          <p class="mt-4 font-display text-xl font-bold text-ink">Pune, Maharashtra</p>
          <p class="mt-1 text-sm text-muted">Open to roles across India and internationally</p>
        </div>

        <div>
          <h2 class="eyebrow">Focus areas</h2>
          <ul class="mt-4 space-y-1.5 text-sm text-muted">
            <li>Supply chain & procurement</li>
            <li>Operations & manufacturing</li>
            <li>Project & programme management</li>
            <li>Market research & business development</li>
          </ul>
        </div>

        <div>
          <h2 class="eyebrow">Elsewhere</h2>
          <ul class="mt-4 space-y-1.5">
            {
              socials.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="link-underline text-sm break-words text-muted hover:text-ink"
                    {...item.href.startsWith('http')
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {}}
                  >
                    {item.handle}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </Section>

  <Section eyebrow="Education" title="Where I studied" divider>
    <ul class="space-y-6">
      {
        education.map((entry) => (
          <li class="reveal rounded-2xl border border-line bg-bg-raised p-7 lg:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="font-display text-xl font-bold tracking-tight text-ink">
                {entry.data.degree}
                {entry.data.field && (
                  <span class="text-muted"> — {entry.data.field}</span>
                )}
              </h3>
              <p class="text-sm font-medium text-subtle tabular-nums">
                {entry.data.start} — {entry.data.end}
              </p>
            </div>
            <p class="mt-2 text-sm text-muted">
              {entry.data.institution}
              {entry.data.location && ` · ${entry.data.location}`}
            </p>
            {entry.data.note && (
              <p class="mt-3 inline-block rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent">
                {entry.data.note}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section eyebrow="Certifications" title="Formal training" divider>
    <ul class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
      {
        certifications.map((cert) => (
          <li class="bg-bg p-6">
            <p class="font-display text-base font-bold text-ink">{cert.data.name}</p>
            <p class="mt-1.5 text-sm text-muted">{cert.data.issuer}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    eyebrow="Recognition"
    title="Achievements"
    lead="Some of these are professional. Most of them are just things I was proud to be picked for."
    divider
  >
    <div class="space-y-12">
      {
        categories.map((category) => {
          const items = achievements.filter((a) => a.data.category === category.key);
          if (items.length === 0) return null;
          return (
            <div class="reveal">
              <h3 class="font-display text-lg font-bold tracking-tight text-ink">
                {category.label}
              </h3>
              <ul class="mt-5 divide-y divide-line border-y border-line">
                {items.map((item) => (
                  <li class="py-5">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                      <p class="font-medium text-ink">{item.data.title}</p>
                      {item.data.year && (
                        <p class="text-sm text-subtle tabular-nums">{item.data.year}</p>
                      )}
                    </div>
                    {item.data.detail && (
                      <p class="prose-body mt-1.5 text-[0.9rem]">{item.data.detail}</p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>

    <div class="mt-12 flex flex-wrap gap-x-8 gap-y-3">
      <ArrowLink href="/resume">Full résumé</ArrowLink>
      <ArrowLink href="/contact">Say hello</ArrowLink>
    </div>
  </Section>
</BaseLayout>
