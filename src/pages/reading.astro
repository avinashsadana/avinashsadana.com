---
import Bookshelf from '../components/Bookshelf.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBooks } from '../lib/content';

const books = await getBooks();
---

<BaseLayout
  title="Reading"
  description="The shelf — what Avinash Sadana reads, from the Bhagavad Gita to Kahneman to Tenzing Norgay."
>
  <PageHeader
    eyebrow="Reading"
    title="The shelf"
    lead={`${books.length} books, roughly evenly split between working out how systems behave and working out how people do.`}
  />

  <Section>
    <Bookshelf />
  </Section>
</BaseLayout>
