---
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import ShareButtons from '../components/ShareButtons.astro';
import Stat from '../components/Stat.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEndurance } from '../lib/content';

const entries = await getEndurance();

const categoryLabel: Record<string, string> = {
  race: 'Race',
  ride: 'Ride',
  run: 'Trail running',
  triathlon: 'Triathlon',
  ambassador: 'Ambassador',
};
---

<BaseLayout
  title="Endurance"
  description="Ultra-distance cycling and trail running — a 1000 km unsupported ride, 2nd at the 646 km Deccan Cliffhanger, multiple trail ultras, triathlon, and Key Opinion Leader work with Saucony."
>
  <PageHeader
    eyebrow="Endurance"
    title="Long distances, planned properly"
    lead="Ultra-distance on a bike and on foot. The results matter less than what the training taught me about planning for the version of yourself that is exhausted."
  />

  <div class="border-y border-line bg-bg-raised">
    <div class="shell grid grid-cols-2 gap-x-6 gap-y-10 py-12 lg:grid-cols-4 lg:py-16">
      <Stat value={1000} suffix=" km" label="Longest ride" detail="Unsupported, self-planned" />
      <Stat value={646} suffix=" km" label="Longest race" detail="2nd, Deccan Cliffhanger" delay={80} />
      <Stat value={2} suffix=" sports" label="On foot and wheels" detail="Trail ultras and cycling" delay={160} />
      <Stat value={2018} label="Going since" detail="Founded Cycle N’ Chai" delay={240} />
    </div>
  </div>

  <Section>
    <div class="space-y-8">
      {
        entries.map((entry, index) => (
          <article
            class="reveal rounded-2xl border border-line bg-bg-raised p-7 lg:p-10"
            style={`--reveal-delay: ${index * 80}ms`}
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
              <div>
                <p class="text-xs font-semibold tracking-[0.14em] text-accent uppercase">
                  {categoryLabel[entry.data.category] ?? entry.data.category}
                  {entry.data.year && ` · ${entry.data.year}`}
                </p>
                <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-ink lg:text-3xl">
                  {entry.data.title}
                </h2>
                {entry.data.location && (
                  <p class="mt-1.5 text-sm text-muted">{entry.data.location}</p>
                )}
              </div>

              {entry.data.result && (
                <p class="rounded-full bg-accent-soft px-4 py-1.5 text-sm font-semibold text-accent">
                  {entry.data.result}
                </p>
              )}
            </div>

            <p class="prose-body mt-5">{entry.data.summary}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-14 border-t border-line pt-8">
      <ShareButtons title="Avinash Sadana — ultra-distance cycling and triathlon" />
    </div>
  </Section>
</BaseLayout>
