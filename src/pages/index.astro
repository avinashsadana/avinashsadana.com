---
import { Image } from 'astro:assets';
import ArrowLink from '../components/ArrowLink.astro';
import Facets from '../components/Facets.astro';
import Section from '../components/Section.astro';
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/avinash-sadana.jpg';
import { dateRange, getPosts, getVentures } from '../lib/content';
import { site } from '../site.config';

const ventures = await getVentures();
const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout title={site.name} description={site.description}>
  <!-- Hero. Deliberately short: a name, one line, a face, and a way in. -->
  <section class="shell pt-8 pb-12 lg:pt-24 lg:pb-20">
    <p class="eyebrow reveal">Pune, India · Open to opportunities</p>

    <!-- The name leads on every screen. On mobile the portrait previously sat
         above it, so the first thing on a phone was a photo of an unnamed man. -->
    <div class="mt-6 grid items-end gap-6 lg:mt-7 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-12">
      <h1 class="font-display text-display font-bold text-ink">
        <span class="reveal block">Avinash</span>
        <span class="reveal block text-accent" style="--reveal-delay: 90ms">Sadana</span>
      </h1>

      <div class="reveal" style="--reveal-delay: 150ms">
        <div class="portrait-frame">
          <Image
            src={portrait}
            alt="Avinash Sadana"
            width={640}
            densities={[1, 2]}
            quality={78}
            loading="eager"
            fetchpriority="high"
            class="portrait-img w-40 sm:w-52 lg:w-[18rem]"
          />
        </div>
      </div>
    </div>

    <!-- Two beats: the setup sits back, the claim lands. Both are one <p> so
         screen readers and search engines read it as the single sentence it is. -->
    <p
      class="reveal mt-9 max-w-3xl font-display text-2xl leading-snug font-semibold tracking-tight text-balance lg:mt-16 lg:text-4xl"
      style="--reveal-delay: 180ms"
    >
      <span class="block text-subtle">Good ideas are everywhere.</span>
      <span class="block text-ink">I make them work.</span>
    </p>

    <div class="reveal mt-7 flex flex-wrap items-center gap-3" style="--reveal-delay: 240ms">
      <a href="/work" class="btn-primary">
        See the work
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h13M12 5.5 18.5 12 12 18.5"></path>
        </svg>
      </a>
      <a href="/contact" class="btn-secondary">Get in touch</a>
    </div>
  </section>

  <!-- Breadth, shown rather than described. -->
  <Section eyebrow="In short" title="Six ways in" divider>
    <Facets />
  </Section>

  <!-- Everything at once -->
  <Section
    eyebrow="The whole picture"
    title="Mostly at the same time"
    lead="Work, study, ventures, sport and recognition on parallel tracks. Hover or tap anything."
    divider
  >
    <Timeline />
  </Section>

  <!-- Ventures -->
  <Section eyebrow="Ventures" title="Things I built" divider>
    <div class="grid gap-6 lg:grid-cols-2">
      {
        ventures.map((venture, index) => (
          <a
            href={`/ventures/${venture.id}`}
            class="reveal group flex flex-col justify-between rounded-2xl border border-line bg-bg-raised p-7 transition-colors hover:border-line-strong lg:p-9"
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <div>
              <p class="text-xs font-semibold tracking-[0.14em] text-accent uppercase">
                {dateRange(venture.data.start, venture.data.end, venture.data.current)}
              </p>
              <h3 class="mt-3 font-display text-2xl font-bold tracking-tight text-ink lg:text-3xl">
                <span class="link-underline">{venture.data.name}</span>
              </h3>
              <p class="mt-2 text-sm text-muted">{venture.data.tagline}</p>
            </div>

            {venture.data.stats.length > 0 && (
              <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-4 border-t border-line pt-6">
                {venture.data.stats.map((stat) => (
                  <div>
                    <dt class="text-xs tracking-wide text-subtle uppercase">{stat.label}</dt>
                    <dd class="mt-1 font-display text-xl font-bold text-ink">{stat.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Writing -->
  {
    posts.length > 0 && (
      <Section eyebrow="Writing" title="Recent thinking" divider>
        <ul class="divide-y divide-line border-y border-line">
          {posts.map((post, index) => (
            <li class="reveal" style={`--reveal-delay: ${index * 70}ms`}>
              <a href={`/writing/${post.id}`} class="group flex flex-wrap items-baseline gap-x-6 gap-y-1 py-6">
                <span class="font-mono text-xs text-subtle">
                  {post.data.tags[0] ?? 'Essay'}
                </span>
                <h3 class="flex-1 font-display text-xl font-bold tracking-tight text-ink lg:text-2xl">
                  <span class="link-underline">{post.data.title}</span>
                </h3>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-9">
          <ArrowLink href="/writing">All writing</ArrowLink>
        </div>
      </Section>
    )
  }
</BaseLayout>
